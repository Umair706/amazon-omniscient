# ============================================================================
# PROJECT OMNISCIENT — Environment Variables
# ============================================================================

# --- Database ---
DATABASE_URL=postgresql+asyncpg://omniscient:password@localhost:5432/omniscient
REDIS_URL=redis://localhost:6379/0

# --- Amazon SP-API ---
SP_API_REFRESH_TOKEN=
SP_API_CLIENT_ID=
SP_API_CLIENT_SECRET=
SP_API_MARKETPLACE_ID=ATVPDKIKX0DER
SP_API_CREDENTIALS_ENCRYPTION_KEY=

# --- Amazon Advertising API ---
AMAZON_ADS_CLIENT_ID=
AMAZON_ADS_CLIENT_SECRET=
AMAZON_ADS_REFRESH_TOKEN=
AMAZON_ADS_PROFILE_ID=

# --- LLM Provider (configurable) ---
LLM_PROVIDER=qwen
LLM_MODEL=qwen-max-latest

# Qwen (DashScope) — DEFAULT
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Anthropic Claude (optional, if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# OpenAI / OpenAI-compatible (optional, if LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Local LLM via Ollama (if LLM_PROVIDER=ollama)
# No API key needed. Default base URL: http://localhost:11434/v1
# Override model with LLM_MODEL=qwen2.5:14b (or any Ollama model)

# Local LLM via vLLM / llama.cpp / etc. (if LLM_PROVIDER=local)
# Uses OPENAI_BASE_URL (default: http://localhost:8080/v1)
# Uses OPENAI_API_KEY (default: not-needed)

# --- Proxy ---
PROXY_PROVIDER=brightdata
PROXY_HOST=
PROXY_PORT=
PROXY_USERNAME=
PROXY_PASSWORD=

# --- Alibaba/1688 API ---
ALIBABA_APP_KEY=
ALIBABA_APP_SECRET=

# --- Freight Rate API ---
FREIGHTOS_API_KEY=
FREIGHTOS_API_SECRET=

# --- Scoring ---
# Hard filter #9 (review-velocity trap) disqualifies only when true. Leave false until
# the threshold is calibrated against the ratings count.
REVIEW_VELOCITY_FILTER_ENABLED=false

# --- Licensing (open-core) ---
# Paste the license key you were issued to unlock Pro/Agency features. Empty = free tier.
# A key is issued to you when you buy; paste it here.
LICENSE_KEY=
# Maintainers only: set this to your public key if you did not embed it in source.
LICENSE_PUBLIC_KEY=

# --- Application ---
APP_SECRET_KEY=change-me-in-production
ALLOWED_ORIGINS=http://localhost:3000
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
LOG_LEVEL=INFO
